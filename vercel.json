{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/audit/:path*",
      "destination": "/api/audit"
    },
    {
      "source": "/audit/:path*",
      "destination": "/audit-private.html"
    },
    {
      "source": "/checkout/strategy-sprint",
      "destination": "/strategy-sprint.html"
    },
    {
      "source": "/checkout/strategy-sprint/thank-you",
      "destination": "/strategy-sprint-thank-you.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/audit/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/audit.js": {
      "includeFiles": "{server/audit/pdf-assets/**,node_modules/pdfkit/js/standard-fonts/**}",
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/marketing-clarity-audit",
      "destination": "/marketing-clarity-assesment",
      "permanent": true
    }
  ]
}
