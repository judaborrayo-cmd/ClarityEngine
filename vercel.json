      "destination": "/pages/strategy-sprint.html"
    },
    {
      "source": "/checkout/strategy-sprint",
      "destination": "/pages/checkout/strategy-sprint.html"
    },
    {
      "source": "/checkout/strategy-sprint/",
      "destination": "/pages/checkout/strategy-sprint.html"
    },
    {
      "source": "/services",
      "destination": "/pages/services.html"
    },
    {
      "source": "/services/",
      "destination": "/pages/services.html"
    },
    {
      "source": "/case-studies",
      "destination": "/pages/case-studies.html"
    },
    {
      "source": "/case-studies/",
      "destination": "/pages/case-studies.html"
    },
    {
      "source": "/testimonials",
      "destination": "/pages/testimonials.html"
    },
    {
      "source": "/testimonials/",
      "destination": "/pages/testimonials.html"
    },
    {
      "source": "/growth-clarity-audit",
      "destination": "/pages/growth-clarity-audit.html"
    },
    {
      "source": "/growth-clarity-audit/",
      "destination": "/pages/growth-clarity-audit.html"
    },
    {
      "source": "/checkout/audit",
      "destination": "/pages/checkout/audit.html"
    },
    {
      "source": "/checkout/audit/",
      "destination": "/pages/checkout/audit.html"
    },
    {
      "source": "/steven",
      "destination": "/pages/steven.html"
    },
    {
      "source": "/steven/",
      "destination": "/pages/steven.html"
    },
    {
      "source": "/ways-to-work-together",
      "destination": "/pages/ways-to-work-together.html"
    },
    {
      "source": "/ways-to-work-together/",
      "destination": "/pages/ways-to-work-together.html"
    },
    {
      "source": "/case-study/hapi-art",
      "destination": "/pages/case-study/hapi-art.html"
    },
    {
      "source": "/case-study/hapi-art/",
      "destination": "/pages/case-study/hapi-art.html"
    },
    {
      "source": "/case-study/lamark-agency",
      "destination": "/pages/case-study/lamark-agency.html"
    },
    {
      "source": "/case-study/lamark-agency/",
      "destination": "/pages/case-study/lamark-agency.html"
    },
    {
      "source": "/case-study/mandali-retreats",
      "destination": "/pages/case-study/mandali-retreats.html"
    },
    {
      "source": "/case-study/mandali-retreats/",
      "destination": "/pages/case-study/mandali-retreats.html"
    },
    {
      "source": "/case-study/powers-gymnastics",
      "destination": "/pages/case-study/powers-gymnastics.html"
    },
    {
      "source": "/case-study/powers-gymnastics/",
      "destination": "/pages/case-study/powers-gymnastics.html"
    },
    {
      "source": "/case-study/core-40",
      "destination": "/pages/case-study/core-40.html"
    },
    {
      "source": "/case-study/core-40/",
      "destination": "/pages/case-study/core-40.html"
    },
    {
      "source": "/case-study/fitness-roi",
      "destination": "/pages/case-study/fitness-roi.html"
    },
    {
      "source": "/case-study/fitness-roi/",
      "destination": "/pages/case-study/fitness-roi.html"
    },
    {
      "source": "/case-study/steel-fit-usa",
      "destination": "/pages/case-study/steel-fit-usa.html"
    },
    {
      "source": "/case-study/steel-fit-usa/",
      "destination": "/pages/case-study/steel-fit-usa.html"
    },
    {
      "source": "/case-study/lisa-nichols",
      "destination": "/pages/case-study/lisa-nichols.html"
    },
    {
      "source": "/case-study/lisa-nichols/",
      "destination": "/pages/case-study/lisa-nichols.html"
    },
    {
      "source": "/checkout/strategy-sprint/thank-you",
      "destination": "/pages/checkout/strategy-sprint/thank-you.html"
    },
    {
      "source": "/checkout/strategy-sprint/thank-you/",
      "destination": "/pages/checkout/strategy-sprint/thank-you.html"
    },
    {
      "source": "/checkout/audit/thank-you",
      "destination": "/pages/checkout/audit/thank-you.html"
    },
    {
      "source": "/checkout/audit/thank-you/",
      "destination": "/pages/checkout/audit/thank-you.html"
    },
    {
      "source": "/checkout/audit/onboarding-confirmed",
      "destination": "/pages/checkout/audit/onboarding-confirmed.html"
    },
    {
      "source": "/checkout/audit/onboarding-confirmed/",
      "destination": "/pages/checkout/audit/onboarding-confirmed.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/audit/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/audit.js": {
      "includeFiles": "{server/audit/pdf-assets/**,node_modules/pdfkit/js/standard-fonts/**}",
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/marketing-clarity-audit",
      "destination": "/marketing-clarity-assesment",
      "permanent": true
    }
  ]
}
