{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/audit/:path*",
      "destination": "/api/audit"
    },
    {
      "source": "/audit/:path*",
      "destination": "/audit-private.html"
    },
    {
      "source": "/about",
      "destination": "/pages/about.html"
    },
    {
      "source": "/about/",
      "destination": "/pages/about.html"
    },
    {
      "source": "/marketing-clarity-assesment",
      "destination": "/pages/marketing-clarity-assesment.html"
    },
    {
      "source": "/marketing-clarity-assesment/",
      "destination": "/pages/marketing-clarity-assesment.html"
    },
    {
      "source": "/strategy-sprint",
      "destination": "/pages/strategy-sprint.html"
    },
